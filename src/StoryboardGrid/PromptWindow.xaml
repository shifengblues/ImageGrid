<Window x:Class="StoryboardGrid.PromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="提示" Width="464" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="DialogKeyDown">
 <Border Margin="12" Padding="24" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" TextElement.Foreground="{DynamicResource Text}">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.14"/></Border.Effect>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel MouseLeftButtonDown="DragHeader"><Button DockPanel.Dock="Right" Content="×" Click="Cancel" ToolTip="关闭" Padding="4" Width="28" Height="28" BorderThickness="0" Background="Transparent" FontSize="18" Margin="12,0,0,0"/><TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,26"><TextBlock x:Name="Message" FontSize="13" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" LineHeight="23"/></ScrollViewer>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" MinWidth="84" Click="Cancel"/><Button x:Name="ConfirmButton" Content="知道了" MinWidth="104" Click="Accept" Style="{StaticResource Primary}" Margin="0"/></StackPanel>
  </Grid>
 </Border>
</Window>
